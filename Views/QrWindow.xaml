<Window x:Class="MacroDeck.Server.Views.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telefon Eşleştirme QR Kodu"
        Height="520" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="#121316"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Padding="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Başlık -->
            <TextBlock Text="Mobil Uygulama Eşleştirme"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <TextBlock Text="Android telefonunuzdaki uygulamayı açıp aşağıdaki QR kodu kamerayla taratın."
                       FontSize="12" Foreground="#94A3B8"
                       TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="340" Margin="0,0,0,14"/>

            <!-- Ağ Adaptörü Seçici (Birden fazla ağ varsa) -->
            <StackPanel Margin="0,0,0,14" HorizontalAlignment="Center">
                <TextBlock Text="Ağ Bağlantısı (IP):" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbAdapters" Width="260" Height="30"
                          Background="#1E222D" Foreground="#F8FAFC"
                          SelectionChanged="CmbAdapters_SelectionChanged"/>
            </StackPanel>

            <!-- QR Kod Kartı -->
            <Border Background="#FFFFFF" CornerRadius="12" Padding="14"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="ImgQrCode" Width="190" Height="190"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <!-- Bağlantı Bilgisi -->
            <Border Background="#1E222D" CornerRadius="8" Padding="12,8"
                    Margin="0,14,0,14" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtConnectionInfo" Text="IP: 192.168.1.x:8765"
                           FontFamily="Consolas" FontSize="13"
                           Foreground="#38BDF8" FontWeight="Bold"/>
            </Border>

            <!-- Kapat Butonu -->
            <Button Content="Kapat" Width="120" Height="36"
                    Background="#334155" Foreground="#FFFFFF"
                    BorderThickness="0" Cursor="Hand"
                    Click="Close_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Border>
</Window>

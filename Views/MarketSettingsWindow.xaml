<Window x:Class="MacroDeck.Server.Views.MarketSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piyasa Takip Ayarları (Borsa, Altın, Kripto)"
        Height="620" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117" Foreground="#F1F5F9"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Seçili Varlıklar Kartı (Max 4) -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Varlık Seçim Listesi (Tabs / Presets) -->
            <RowDefinition Height="*"/>
            <!-- 3: Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="📈 Canlı Piyasa Takip Yönetimi" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Telefonda canlı takip edilecek en fazla 10 varlığı seçin. Veriler telefon tarafından anlık çekilir."
                           FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 1: Seçili Varlıklar Kartı (Max 10) -->
        <Border Grid.Row="1" Background="#141822" BorderBrush="#1E293B" BorderThickness="1"
                CornerRadius="10" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="📌 Seçili Varlıklar (Maksimum 10 Adet)" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                    <TextBlock x:Name="TxtSelectedCount" Text="0 / 10 Seçildi" FontSize="12" FontWeight="Bold"
                               Foreground="#38BDF8" HorizontalAlignment="Right"/>
                </Grid>

                <ItemsControl x:Name="ItemsSelected">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E2433" BorderBrush="{Binding ColorBrush}" BorderThickness="1.5"
                                    CornerRadius="8" Padding="10,6" Margin="0,0,10,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{Binding ColorBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                    <Button Content="✕" Width="18" Height="18" FontSize="10"
                                            Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                            Cursor="Hand" Click="BtnRemoveItem_Click" Tag="{Binding Id}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 2: Varlık Ekleme Alanı -->
        <Border Grid.Row="2" Background="#141822" BorderBrush="#1E293B" BorderThickness="1"
                CornerRadius="10" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Katalogdan Varlık Seçin veya Özel Sembol Ekleyin:"
                           FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,10"/>

                <!-- Preset Listesi -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelPresets">
                        <!-- Kod tarafından dinamik butonlar doldurulacak -->
                    </StackPanel>
                </ScrollViewer>

                <!-- Özel Sembol Ekleme -->
                <Border Grid.Row="2" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCustomSymbol" Height="32" Padding="8,4"
                                 Background="#1E222D" Foreground="#F8FAFC" BorderBrush="#334155"
                                 Text="Örn: KCHOL.IS veya SOLUSDT" GotFocus="TxtCustomSymbol_GotFocus"/>
                        <Button Grid.Column="1" Content="+ Özel Ekle" Margin="8,0,0,0" Height="32" Padding="12,0"
                                Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand" Click="BtnAddCustom_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 3: Footer Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="İptal" Width="100" Height="36" Margin="0,0,10,0"
                    Background="#1E293B" Foreground="#94A3B8" BorderThickness="1" BorderBrush="#334155"
                    Cursor="Hand" Click="BtnCancel_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="💾 Kaydet ve Telefona Gönder" Height="36" Padding="16,0"
                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand" Click="BtnSave_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>

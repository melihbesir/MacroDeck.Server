<Window x:Class="MacroDeck.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MacroDeck Server - Masaüstü Kontrol Merkezi"
        Icon="Resources/app_icon.png"
        Height="840" Width="1160" MinHeight="750" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117" Foreground="#F1F5F9"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Modern ScrollViewer / Button Styles -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Editor Card (Top) -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Live Preview (Phone Screen) -->
            <RowDefinition Height="*"/>
            <!-- 3: Action & Status Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 0: HEADER ==================== -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12"
                BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Resources/app_icon.png" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="MACRO DECK" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Masaüstü Kontrol ve Senkronizasyon Merkezi" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- Connection Badge & Weather City -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="BadgeConnection" Background="#3B2612" CornerRadius="16" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotConnection" Width="8" Height="8" Fill="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtConnectionStatus" Text="○ Telefon Bekleniyor (192.168.1.x:8765)"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Border>

                    <!-- Şehir / Konum Seçici -->
                    <Border Background="#1E293B" CornerRadius="16" Padding="10,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📍 Şehir:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtCityName" Text="İstanbul" Width="85" Height="24" Padding="6,2" FontSize="11" VerticalAlignment="Center"/>
                            <Button Content="Yenile" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10" Margin="6,0,0,0" Click="BtnRefreshWeather_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAutoStart" Content="🚀 Windows ile Başlat"
                              Foreground="#94A3B8" FontSize="11" FontWeight="Medium"
                              VerticalAlignment="Center" Margin="0,0,12,0"
                              Checked="ChkAutoStart_Checked" Unchecked="ChkAutoStart_Unchecked"
                              ToolTip="Bilgisayar açıldığında MacroDeck'i arka planda otomatik başlatır."/>
                    <Button Content="📈 Genel Piyasa Ayarları" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="BtnMarketSettings_Click"
                            ToolTip="Tüm hücreler için varsayılan borsa/kripto/altın takip listesi"/>
                    <Button Content="📱 Eşleştirme QR Kodu" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="BtnShowQr_Click"/>
                    <Button Content="📥 Tepsiye Küçült" Style="{StaticResource SecondaryButton}"
                            Click="BtnMinimizeToTray_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 1: BUTTON EDITOR CARD ==================== -->
        <Border Grid.Row="1" Background="#141822" BorderBrush="#1E293B" BorderThickness="1"
                CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Editor Başlığı & Seçili Hücre Bilgisi & Grid Boyutu -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛠️ Buton Yapılandırması" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,12,0"/>
                        <Border Background="#1E293B" CornerRadius="4" Padding="8,2">
                            <TextBlock x:Name="TxtSelectedCellInfo" Text="Seçili Hücre: [1, 1]" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Grid Boyutu Barları (Min 3 - Max 5) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="#0F1117" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📐 Grid Boyutu:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <!-- Sütun (Genişlik) Slider -->
                                <TextBlock Text="Sütun (Genişlik):" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider x:Name="SliderColumns" Minimum="3" Maximum="5" Value="5" Width="75"
                                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        ValueChanged="SliderGridDimensions_ValueChanged"/>
                                <TextBlock x:Name="TxtColumnsVal" Text="5" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Width="14" Margin="4,0,16,0" VerticalAlignment="Center"/>

                                <!-- Satır (Yükseklik) Slider -->
                                <TextBlock Text="Satır (Yükseklik):" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider x:Name="SliderRows" Minimum="3" Maximum="5" Value="4" Width="75"
                                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        ValueChanged="SliderGridDimensions_ValueChanged"/>
                                <TextBlock x:Name="TxtRowsVal" Text="4" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Width="14" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="2" HorizontalAlignment="Right" Content="✕ Hücreyi Sıfırla"
                            Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"
                            Click="BtnResetButton_Click"/>
                </Grid>

                <!-- Input Kontrolleri -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2.8*"/>
                        <ColumnDefinition Width="2.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 0: Eylem Türü -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Eylem Türü:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbActionType" SelectionChanged="CmbActionType_SelectionChanged"
                                  Background="#1E222D" Foreground="#F8FAFC" Height="30">
                            <ComboBoxItem Content="🚀 Uygulama Çalıştır" Tag="app" IsSelected="True"/>
                            <ComboBoxItem Content="⛅ Hava Durumu" Tag="weather"/>
                            <ComboBoxItem Content="📈 Piyasa Takip" Tag="market"/>
                            <ComboBoxItem Content="🖥️ Sistem Monitörü" Tag="system"/>
                            <ComboBoxItem Content="🎯 Uygulama Takibi" Tag="process"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 1: Buton İsmi -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Buton Başlığı / İsim:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtButtonTitle" TextChanged="TxtButtonTitle_TextChanged"
                                 ToolTip="Buton üzerinde görünecek kısa isim"/>
                    </StackPanel>

                    <!-- 2: Hedef Uygulama Yolu veya Hava Durumu / Piyasa / Sistem Bilgisi -->
                    <Grid Grid.Column="2" Margin="0,0,10,0">
                        <StackPanel x:Name="PanelAppPath">
                            <TextBlock Text="Uygulama (.exe) Yolu veya Komut:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtAppPath" TextChanged="TxtAppPath_TextChanged"
                                         ToolTip="Program yolu (.exe, .lnk veya doğrudan tırnaklı komut satırı)"/>
                                <Button Grid.Column="1" Content="Gözat..." Style="{StaticResource SecondaryButton}"
                                         Margin="6,0,0,0" Click="BtnBrowseApp_Click"/>
                            </Grid>
                            <TextBlock Text="Başlatma Parametreleri / Argümanlar (Opsiyonel):" FontSize="10" Foreground="#64748B" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtAppArgs" TextChanged="TxtAppArgs_TextChanged" FontSize="11" Height="26"
                                     ToolTip="Örnek: -dataPath=&quot;C:\ProgramData\SteelSeries\GG&quot; -dbEnv=production"/>
                        </StackPanel>

                        <Border x:Name="PanelWeatherInfo" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" Visibility="Collapsed">
                            <TextBlock Text="⛅ Tıklandığında telefonda interaktif Hava Durumu ekranı açılır."
                                       FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Border>

                        <Border x:Name="PanelMarketInfo" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="📈 Canlı Piyasa Takip Hücresi"
                                               FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                    <TextBlock x:Name="TxtCellMarketSummary"
                                               Text="Takip: Varsayılan Liste"
                                               FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="⚙️ Varlıkları Ayarla"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,4" FontSize="11"
                                        Click="BtnEditCellMarket_Click"
                                        ToolTip="Bu özel hücrede takip edilecek kripto/borsa/altın varlıklarını seçin"/>
                            </Grid>
                        </Border>

                        <Border x:Name="PanelSystemInfo" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="🖥️ Sistem Kaynakları İzleme (PC Monitörü)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Raporlama Aralığı:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider Grid.Column="1" x:Name="SliderSystemInterval" Minimum="0.5" Maximum="5.0" Value="1.0"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="SliderSystemInterval_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtSystemIntervalVal" Text="1.0 sn" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Width="42" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PanelProcessInfo" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="🎯 Takip Edilecek Uygulama (.exe) Adı:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtProcessTarget" TextChanged="TxtProcessTarget_TextChanged"
                                             ToolTip="Örnek: chrome.exe, GTA5.exe veya boş bırakarak aktif pencere"/>
                                    <ComboBox Grid.Column="1" x:Name="CmbRunningProcesses" Width="135" Margin="6,0,0,0"
                                              SelectionChanged="CmbRunningProcesses_SelectionChanged"
                                              DropDownOpened="CmbRunningProcesses_DropDownOpened"
                                              ToolTip="Şu an PC'de açık olan işlemlerden seçin"/>
                                    <Button Grid.Column="2" Content="Gözat..." Style="{StaticResource SecondaryButton}"
                                            Margin="6,0,0,0" Click="BtnBrowseProcessExe_Click"/>
                                </Grid>
                                <TextBlock Text="İpucu: Belirli bir exe seçerseniz (örn. GTA5.exe) telefon açıldığında o exe'yi otomatik takip eder." FontSize="9.5" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 3: İkon / Resim Seçici -->
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="Buton İkonu / Resmi:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtIconPath" IsReadOnly="True"
                                     ToolTip="Butonda gösterilecek resim dosyası"/>
                            <Button Grid.Column="1" Content="Resim..." Style="{StaticResource SecondaryButton}"
                                    Margin="6,0,0,0" Click="BtnBrowseIcon_Click"/>
                            <Button Grid.Column="2" Content="✕" Style="{StaticResource SecondaryButton}"
                                    Margin="4,0,0,0" Click="BtnClearIcon_Click" ToolTip="İkonu Kaldır"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== 2: CANLI ÖN İZLEME (TELEFON EKRANI) ==================== -->
        <Border Grid.Row="2" Background="#000000" BorderBrush="#334155" BorderThickness="3"
                CornerRadius="16" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Telefon Üst Bilgi Barı (Tarih & Saat) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Ana Alan (5x4 Grid + Sağ Ses Barı) -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sağ Üst: Gün-Ay Tarih ve Canlı Dijital Saat -->
                <Grid Grid.Row="0" Margin="0,0,6,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPreviewHeader" Text="📱 MONİTÖR ALTI TELEFON CANLI ÖN İZLEME (5x4)"
                                   FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Gün-Ay Formatı (Örn: 24 Ekim) -->
                        <TextBlock x:Name="TxtPreviewDate" Text="24 Ekim"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,12,0"/>
                        <!-- Canlı Saat -->
                        <TextBlock x:Name="TxtPreviewTime" Text="12:45"
                                   FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </StackPanel>
                </Grid>

                <!-- İçerik: 5x4 Grid ve En Sağ Dikey Ses Barı -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Buton Grid Alanı -->
                        <ColumnDefinition Width="*"/>
                        <!-- En Sağ Dikey Ses Barı -->
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <!-- 5x4 Grid Ön İzleme -->
                    <UniformGrid Grid.Column="0" Rows="4" Columns="5" Margin="0,0,12,0" x:Name="PreviewUniformGrid">
                        <!-- Kod tarafından dinamik buton kartları doldurulur -->
                    </UniformGrid>

                    <!-- En Sağ: Dikey Ses Barı + Altta % Göstergesi -->
                    <Border Grid.Column="1" Background="Transparent" BorderThickness="0"
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- İkon / Başlık -->
                                <RowDefinition Height="Auto"/>
                                <!-- Dikey Ses Barı Slider -->
                                <RowDefinition Height="*"/>
                                <!-- Ses Yüzdesi Göstergesi (%45) -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="🔊 SES" FontSize="11" FontWeight="Bold"
                                       Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                            <!-- Dikey Ses Slider (Windows Master Volume) -->
                            <Slider Grid.Row="1" x:Name="SliderPreviewVolume" Orientation="Vertical"
                                    Minimum="0" Maximum="100" Value="50"
                                    HorizontalAlignment="Center" Margin="0,4"
                                    ValueChanged="SliderPreviewVolume_ValueChanged"/>

                            <!-- Yüzde Göstergesi (Örn: %50) -->
                            <Border Grid.Row="2" Background="#1E293B" CornerRadius="6" Padding="4,4" Margin="0,8,0,0">
                                <TextBlock x:Name="TxtPreviewVolumePercent" Text="%50"
                                           FontSize="13" FontWeight="Bold" Foreground="#38BDF8"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== 3: FOOTER ACTION & STATUS ==================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Uyarı / Bildirim Mesajı Kartı -->
            <Border Grid.Column="0" x:Name="CardStatusNotification"
                    Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatusNotification"
                           Text="Hazır: Butonları düzenleyip 'Tasarımı Kaydet ve Telefona Gönder' butonuna basabilirsiniz."
                           FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap"/>
            </Border>

            <!-- Ana Kaydet ve Gönder Butonu -->
            <Button Grid.Column="1" x:Name="BtnSaveAndSync"
                    Content="💾 Tasarımı Kaydet ve Telefona Gönder"
                    Style="{StaticResource ActionButton}"
                    FontSize="14" Padding="20,12"
                    Click="BtnSaveAndSync_Click"/>
        </Grid>
    </Grid>
</Window>
